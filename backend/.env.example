# Fishtank Dashboard Configuration
# Copy this file to .env and fill in your credentials.

# Option 1: Automatic auth (recommended)
# The dashboard will login automatically and refresh tokens as needed.
FISHTANK_EMAIL=your_email@example.com
FISHTANK_PASSWORD=your_password

# Option 2: Manual cookie (legacy)
# Copy from Network tab > Request Headers > Cookie header.
# Only needed if you don't want to use email/password auth.
# FISHTANK_COOKIE=your_short_cookie_value
